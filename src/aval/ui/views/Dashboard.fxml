<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" styleClass="root"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="aval.ui.controller.DashboardController">

    <left>
        <VBox prefWidth="200.0" spacing="10.0" styleClass="sidebar">
            <padding>
                <Insets top="40" right="10" bottom="10" left="10"/>
            </padding>
            <Button maxWidth="Infinity" onAction="#showIngestion" styleClass="sidebar-button" text="Ingestion" />
            <Button maxWidth="Infinity" onAction="#showAILab" styleClass="sidebar-button" text="AI Lab" />
            <Button maxWidth="Infinity" onAction="#showReconciliation" styleClass="sidebar-button" text="Reconciliation" />
            <Button maxWidth="Infinity" styleClass="sidebar-button" text="Audit" />
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="10.0" styleClass="top-bar">
            <padding>
                <Insets right="20.0" />
            </padding>
            <Label style="-fx-font-weight: bold;" text="AVAL AIRE" />
            <HBox HBox.hgrow="ALWAYS" />
            <ToggleButton fx:id="themeToggle" onAction="#handleThemeToggle" styleClass="theme-toggle" text="Dark Mode" />
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea">
            <padding>
                <Insets all="40.0" />
            </padding>
            <VBox spacing="30.0">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Data Ingestion" />

                <VBox fx:id="dropZone" alignment="CENTER" maxHeight="200.0" maxWidth="500.0" spacing="10.0" styleClass="drop-zone">
                    <Label style="-fx-font-size: 40px;" text="📁" />
                    <Label text="Drag and drop .xlsx or .pdf files here" />
                </VBox>

                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Active Client Organizations" />
                <FlowPane fx:id="clientCardsArea" hgap="20.0" vgap="20.0" />
            </VBox>
        </StackPane>
    </center>

</BorderPane>
