<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="aval.ui.controller.ReconciliationController"
            styleClass="root">

    <VBox AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" spacing="10.0">
        <padding>
            <Insets all="20.0" />
        </padding>

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Reconciliation Workspace" />

        <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS" styleClass="reconciliation-split-pane">
            <items>
                <VBox spacing="5.0">
                    <Label style="-fx-font-weight: bold;" text="INTERNAL LEDGER" />
                    <TableView fx:id="ledgerTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="lDateCol" text="Date" prefWidth="100"/>
                            <TableColumn fx:id="lRefCol" text="Ref No" prefWidth="100"/>
                            <TableColumn fx:id="lNarrativeCol" text="Narrative" prefWidth="250"/>
                            <TableColumn fx:id="lAmountCol" text="Amount" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
                <VBox spacing="5.0">
                    <Label style="-fx-font-weight: bold;" text="BANK STATEMENT" />
                    <TableView fx:id="bankTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="bDateCol" text="Date" prefWidth="100"/>
                            <TableColumn fx:id="bRefCol" text="Ref No" prefWidth="100"/>
                            <TableColumn fx:id="bNarrativeCol" text="Narrative" prefWidth="250"/>
                            <TableColumn fx:id="bAmountCol" text="Amount" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </items>
        </SplitPane>
    </VBox>

    <HBox fx:id="floatingActionBar" alignment="CENTER" spacing="30.0"
          visible="false" managed="false"
          AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0"
          styleClass="floating-action-bar">
        <padding>
            <Insets top="15.0" right="30.0" bottom="15.0" left="30.0" />
        </padding>

        <Label fx:id="confidenceLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Confidence Score: 94%" />

        <HBox spacing="10.0">
            <Button styleClass="approve-button" text="Approve Match" prefWidth="150" />
            <Button styleClass="reject-button" text="Reject / Manual Override" prefWidth="200" />
        </HBox>
    </HBox>

</AnchorPane>
