<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<StackPane prefHeight="400.0" prefWidth="600.0"
           style="-fx-background-color: #FAF9F6;"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="aval.ui.controller.SplashController">

    <AnchorPane>
        <VBox layoutX="50.0" layoutY="140.0" spacing="-10">
            <Label text="AVAL" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;" />
            <Label text="AIRE" style="-fx-font-size: 24px; -fx-font-weight: 300; -fx-text-fill: #1A1A1A;" />
        </VBox>

        <VBox AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" spacing="5">
            <Label fx:id="logLabel" text="Initializing..."
                   style="-fx-font-family: 'Consolas', 'Monospaced'; -fx-font-size: 10px; -fx-text-fill: #6C757D;" />
        </VBox>
    </AnchorPane>

    <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="2.0" progress="0.0"
                 StackPane.alignment="BOTTOM_CENTER" styleClass="splash-progress" />

</StackPane>
